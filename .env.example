# Shared secret for admin endpoints (/v1/keys, /v1/revoke, /v1/approvals*, /v1/audit/verify).
# Required in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADP_ADMIN_TOKEN=

# Durable state (revocations, budgets, approvals, audit, trusted keys).
# Unset means in-memory: fine for tests, unsafe in production.
ADP_DB=./adp.db

# Reverse-proxy routes: name=url,action,resource_prefix[,cost[,purpose]];...
ADP_ROUTES=property=http://property-api:9000,property.read,mumbai://rr,1
